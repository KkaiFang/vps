# ============================================================
#  复制成 .env 后修改。.env 不会被提交到仓库。
#  取值中不要出现空格、#、$、反引号，除非用引号包起来。
# ============================================================

# ---------- 基础 ----------
# Let's Encrypt 通知邮箱，申请证书必须填写
ACME_EMAIL=you@example.com

# 时区
TZ=Asia/Shanghai

# ---------- 功能开关 ----------
ENABLE_CADDY=true
ENABLE_PROXY=true
ENABLE_MONITOR=true
ENABLE_APPS=true

# 关闭密码登录（只留公钥）。只有在服务器上已有 authorized_keys 时才生效
ENABLE_SSH_HARDENING=true

# ---------- 站点域名 ----------
# 留空 = 不生成该站点。域名需提前解析到本机 IP，否则证书申请会失败。
DOMAIN_MONITOR=
DOMAIN_PORTAINER=
DOMAIN_ALIST=
DOMAIN_VAULT=
DOMAIN_MEMOS=

# ---------- 代理节点 ----------
# 对外监听端口。Caddy 占用 80/443，所以这里用 8443/8444
PROXY_REALITY_PORT=8443
PROXY_HY2_PORT=8444

# REALITY 伪装目标：必须是支持 TLS1.3 + H2 的境外大站
PROXY_REALITY_SNI=www.microsoft.com

# Hysteria2 自签证书的 CN。留空则用第一个已配置的域名
PROXY_HY2_SNI=

# 直接访问 Hysteria2 端口时伪装成哪个网站。选国内能正常打开的站点
PROXY_HY2_MASQUERADE=www.bing.com

# 节点名称，会出现在分享链接和客户端里
PROXY_NODE_NAME=vps-node

# 取不到公网 IP 时用这个（本机只开了 IPv6 之类的情况）
VPS_IP=

# sing-box 镜像版本，可锁定成具体版本号
SINGBOX_VERSION=latest

# 以下四项留空会在安装时自动生成并写回本文件
PROXY_UUID=
PROXY_REALITY_PRIVATE_KEY=
PROXY_REALITY_PUBLIC_KEY=
PROXY_REALITY_SHORT_ID=
PROXY_HY2_PASSWORD=

# ---------- 自托管应用 ----------
# Vaultwarden 是否允许注册新账号。单人使用保持 false
VAULT_SIGNUPS_ALLOWED=false
# Vaultwarden 管理后台令牌，留空自动生成
VAULT_ADMIN_TOKEN=

# ---------- 系统 ----------
# SSH 端口。留空则自动检测当前 sshd 监听的端口
SSH_PORT=
# SSH 登录用户，用于展示和定位 authorized_keys
SSH_USER=root

# sing-box 日志级别：trace / debug / info / warn / error
LOG_LEVEL=warn

# 是否创建 swap；已经在分区里分过 swap 的机器会自动跳过
ENABLE_SWAP=true
SWAP_SIZE=2G
